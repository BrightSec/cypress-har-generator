{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.*",
      "!tmp",
      "!dist",
      "!coverage",
      "!example",
      "!**/*-lock.json",
      "!**/*.lock"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
