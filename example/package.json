{
  "name": "cypress-har-generator-demo",
  "version": "1.0.0",
  "description": "This is a demo project for the [cypress-har-generator](https://github.com/BrightSec/cypress-har-generator), with some installation and usage examples.",
  "scripts": {
    "cypress:run": "cypress run --browser chrome --headless",
    "start": "node --experimental-transform-types src/index.ts --port 7079",
    "test": "start-test 7079 cypress:run"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "hbs": "^4.4.0",
    "minimist": "^1.2.7",
    "morgan": "^1.12.1",
    "tslib": "^2.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.15",
    "@types/express-session": "^1.17.5",
    "@types/morgan": "^1.9.4",
    "@types/node": "~24.19.2",
    "cypress": "^16.2.0",
    "start-server-and-test": "^2.0.7",
    "typescript": "~6.0.3"
  }
}
